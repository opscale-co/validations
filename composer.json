{
  "name": "opscale-co/validations",
  "description": "Model validation for Laravel application.",
  "type": "library",
  "license": "MIT",
  "require": {
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Opscale\\Validations\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Opscale\\Validations\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "tightenco/duster": "^3.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "orchestra/testbench": "^11.0",
    "mockery/mockery": "^1.6",
    "larastan/larastan": "^3.9",
    "opscale-co/strict-rules": "^1.1",
    "rector/rector": "^2.0"
  },
  "version": "1.0.0",
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
